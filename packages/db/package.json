  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
