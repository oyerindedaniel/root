{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/auth": "./src/schema/auth.ts",
    "./schema/accounts": "./src/schema/accounts.ts",
    "./schema/shop": "./src/schema/shop.ts",
    "./schema/support": "./src/schema/support.ts"
  },
  "scripts": {
