{
  "name": "webMCP",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:providers": "turbo run dev --filter=accounts --filter=shop --filter=support",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "docker:postgres": "docker compose --env-file apps/api/.env.local up -d postgres",
    "docker:up": "docker compose --env-file apps/api/.env.local up -d --build",
    "docker:dev": "docker compose --env-file apps/api/.env.local -f docker-compose.yml -f docker-compose.watch.yml up --watch --build",
    "docker:down": "docker compose --env-file apps/api/.env.local down",
    "docker:logs": "docker compose --env-file apps/api/.env.local logs -f",
    "docker:ps": "docker compose --env-file apps/api/.env.local ps",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:seed": "pnpm --filter @repo/api db:seed",
    "db:seed:providers": "pnpm --filter @repo/api db:seed:providers",
    "db:prod": "node scripts/db-prod.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  }
}
